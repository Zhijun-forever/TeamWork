# ============================================================================
# 非遗数字化管理平台 · 环境变量模板（V2.0 / 2026-11-27）
#
# 用法：把本文件复制为同目录 .env，再填真实值：
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# .env 已被 .gitignore 忽略——真实密钥永不入库。
# 优先级：真实环境变量 > .env > 代码默认值（run.py 的 load_dotenv 不覆盖已有变量）。
# ============================================================================

# --- 必填（演示/验收前）------------------------------------------------------
# 会话 Cookie 与 CSRF token 的签名密钥：任意长随机字符串。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机长字符串

# --- 服务器（run.py 读取）----------------------------------------------------
# 接口约定 V2.0：Base URL = http://127.0.0.1:8000；前端 Vite 代理 /api 与 /media 到此。
HOST=127.0.0.1
PORT=8000

# --- 数据库（可选）-----------------------------------------------------------
# 缺省 SQLite：instance/app.db（自动创建，WAL + 外键强制，见 models.py）。
# 课程演示无需设置。切换 MySQL（报告 5.5）时取消注释并填写，
# 同时安装可选依赖：pip install PyMySQL
# DATABASE_URL=mysql+pymysql://ich:密码@127.0.0.1:3306/ich?charset=utf8mb4

# --- Cookie 安全 -------------------------------------------------------------
# 生产 HTTPS 部署设 1；本地 HTTP 演示保持 0（否则浏览器不回传 Cookie，登录态丢失）。
SESSION_COOKIE_SECURE=0

# --- AI / RAG（M5，周世航）---------------------------------------------------
# 阿里云百炼 DashScope（千问月套餐）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 千问模型：报告 2.1 定为 qwen-turbo（max_tokens=400 在代码中控费）
QWEN_MODEL=qwen-turbo
# 硅基流动 SiliconFlow（bge-m3 向量化，OpenAI 兼容接口）：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# --- 代码内固定常量（非环境变量，此处仅备忘，改值需改 app/__init__.py）--------
# AI_DAILY_LIMIT=15（BR-09 每人每天 15 次，含管理员）
# QWEN_MAX_TOKENS=400；AI_TOP_K=3（Top3 引用）
# 上传限制：图片 ≤10MB / PDF ≤20MB / 请求体总闸 25MB
